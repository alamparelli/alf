#!/usr/bin/env python3
"""
todo — Task manager (SQLite backend)

Usage:
  todo add "text" [--priority high|medium|low] [--category "..."] [--comment "..."] [--deadline YYYY-MM-DD]
  todo list    [--all | --done | --pending] [--category "..."]
  todo done    <id>
  todo undone  <id>
  todo edit    <id> ["new text"] [--priority high|medium|low] [--category "..."] [--comment "..."] [--deadline YYYY-MM-DD]
  todo delete  <id>
  todo help
"""

import sys
import os
import sqlite3
import subprocess
from datetime import date, datetime

DB       = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "apps", "todo", "data", "todo.db")
SCHEDULE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "tools.d", "schedule")

# ── Colours ────────────────────────────────────────────────────────────────────
RESET  = "\033[0m"
DIM    = "\033[2m"
BOLD   = "\033[1m"
GREEN  = "\033[92m"
RED    = "\033[91m"
YELLOW = "\033[93m"
BLUE   = "\033[94m"

PRIORITY_COLOR = {"high": RED, "medium": YELLOW, "low": BLUE}
PRIORITY_ORDER = {"high": 0, "medium": 1, "low": 2}

def now_iso():
    return datetime.now().isoformat(timespec="seconds")

def today():
    return date.today().isoformat()

# ── SQLite storage ─────────────────────────────────────────────────────────────
def connect():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("""CREATE TABLE IF NOT EXISTS todos (
        id          INTEGER PRIMARY KEY AUTOINCREMENT,
        title       TEXT    NOT NULL,
        done        INTEGER NOT NULL DEFAULT 0,
        priority    TEXT    NOT NULL DEFAULT 'medium',
        description TEXT,
        due_date    TEXT,
        category    TEXT    DEFAULT '',
        archived    INTEGER DEFAULT 0,
        archived_at TEXT,
        status      TEXT    DEFAULT 'pending',
        completed_at TEXT   DEFAULT '',
        created_at  TEXT    NOT NULL,
        updated_at  TEXT    NOT NULL
    )""")
    conn.commit()
    return conn

def load():
    with connect() as conn:
        rows = conn.execute(
            "SELECT id,title,done,priority,description,due_date,category,status,created_at,updated_at"
            " FROM todos WHERE archived=0 ORDER BY id"
        ).fetchall()
    return [dict(r) | {"done": bool(r["done"])} for r in rows]

def find_or_die(tid):
    with connect() as conn:
        row = conn.execute("SELECT * FROM todos WHERE id=?", (tid,)).fetchone()
    if not row:
        die(f"Task #{tid} not found.")
    return dict(row) | {"done": bool(row["done"])}

# ── Formatting ─────────────────────────────────────────────────────────────────
def priority_label(p):
    color = PRIORITY_COLOR.get(p, "")
    return f"{color}[{p}]{RESET}"

def fmt_row(t):
    check    = f"{GREEN}✓{RESET}" if t["done"] else " "
    pid      = f"{DIM}#{t['id']}{RESET}"
    title    = f"{DIM}{t['title']}{RESET}" if t["done"] else t["title"]
    pri      = f" {priority_label(t['priority'])}"
    deadline = ""
    if t.get("due_date"):
        overdue  = t["due_date"] < today() and not t["done"]
        dl_color = RED if overdue else DIM
        deadline = f" {dl_color}⏰ {t['due_date']}{RESET}"
    category = f" {BLUE}[{t['category']}]{RESET}" if t.get("category") else ""
    comment  = f"\n       {DIM}{t['description']}{RESET}" if t.get("description") else ""
    return f"  [{check}] {pid} {title}{pri}{category}{deadline}{comment}"

# ── Arg parsing helpers ─────────────────────────────────────────────────────────
def parse_flags(args, flags):
    values = {f: None for f in flags}
    text_parts = []
    i = 0
    while i < len(args):
        matched = False
        for f in flags:
            if args[i] == f and i + 1 < len(args):
                values[f] = args[i + 1]
                i += 2
                matched = True
                break
        if not matched:
            text_parts.append(args[i])
            i += 1
    return text_parts, values

def require_id(args):
    if not args:
        die("Provide a task ID.")
    try:
        return int(args[0])
    except ValueError:
        die(f"'{args[0]}' is not a valid ID.")

def die(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)

# ── Schedule helpers ───────────────────────────────────────────────────────────
def schedule_deadline_alert(tid, title, deadline, priority):
    if not deadline:
        return
    try:
        dt = datetime.strptime(deadline, "%Y-%m-%d")
        if dt.date() <= date.today():
            return
    except ValueError:
        return
    iso   = f"{deadline}T09:00:00+01:00"
    emoji = {"high": "🔴", "medium": "🟠", "low": "🟢"}.get(priority, "📌")
    safe  = title.replace('"', '').replace("'", '')[:120]
    msg   = f"{emoji} Deadline aujourd'hui : {safe}"
    subprocess.run(
        [SCHEDULE, "create", "--name", f"todo-deadline-{tid}",
         "--schedule", iso, "--message", msg, "--output", "telegram"],
        capture_output=True
    )

def cancel_deadline_alert(tid):
    try:
        result = subprocess.run([SCHEDULE, "list"], capture_output=True, text=True)
        for line in result.stdout.splitlines():
            if f"todo-deadline-{tid}" in line:
                job_id = line.split()[0]
                if job_id != "ID":
                    subprocess.run([SCHEDULE, "delete", job_id], capture_output=True)
                break
    except Exception:
        pass

# ── Commands ───────────────────────────────────────────────────────────────────
def cmd_add(args):
    clean_args = [a for a in args if a != "--filter" and not a.startswith("--filter=")]
    text_parts, flags = parse_flags(clean_args, ["--priority", "--comment", "--deadline", "--category"])
    title    = " ".join(text_parts).strip()
    priority = flags["--priority"] or "medium"
    comment  = flags["--comment"] or None
    deadline = flags["--deadline"] or None
    category = flags["--category"] or None

    if not title:
        die("Provide a task description.")
    if priority not in ("high", "medium", "low"):
        die("Priority must be: high, medium, or low.")

    ts = now_iso()
    with connect() as conn:
        cur = conn.execute(
            "INSERT INTO todos (title,done,priority,description,due_date,category,status,created_at,updated_at)"
            " VALUES (?,0,?,?,?,?,'pending',?,?)",
            (title, priority, comment, deadline, category, ts, ts)
        )
        tid = cur.lastrowid
    cat_str = f" {BLUE}[{category}]{RESET}" if category else ""
    dl_str  = f" ⏰ {deadline}" if deadline else ""
    if deadline:
        schedule_deadline_alert(tid, title, deadline, priority)
    print(f"Added #{tid}: {title} {priority_label(priority)}{cat_str}{dl_str}")


def cmd_list(args):
    if "--all" in args:
        mode = "all"
    elif "--done" in args:
        mode = "done"
    else:
        mode = "pending"

    _, flags = parse_flags(args, ["--category"])
    cat_filter = flags["--category"]

    todos = load()
    if mode == "all":
        rows = todos
    elif mode == "done":
        rows = [t for t in todos if t["done"]]
    else:
        rows = [t for t in todos if not t["done"]]

    if cat_filter:
        rows = [t for t in rows if (t.get("category") or "").lower() == cat_filter.lower()]

    label = {"all": "All tasks", "done": "Completed", "pending": "Pending"}[mode]
    if cat_filter:
        label += f" [{cat_filter}]"
    total = len(todos)
    done  = sum(1 for t in todos if t["done"])

    if not rows:
        msgs = {"all": "No tasks.", "done": "No completed tasks.", "pending": "All done!"}
        print(msgs[mode])
        return

    rows = sorted(rows, key=lambda t: (t["done"], PRIORITY_ORDER.get(t["priority"], 1), t["id"]))
    print(f"{BOLD}{label}{RESET} ({done}/{total} done)")
    for t in rows:
        print(fmt_row(t))


def cmd_done(args):
    tid = require_id(args)
    find_or_die(tid)
    ts = now_iso()
    with connect() as conn:
        conn.execute(
            "UPDATE todos SET done=1, status='done', completed_at=?, updated_at=? WHERE id=?",
            (ts, ts, tid)
        )
    cancel_deadline_alert(tid)
    print(f"{GREEN}Done{RESET} #{tid}")


def cmd_undone(args):
    tid = require_id(args)
    find_or_die(tid)
    ts = now_iso()
    with connect() as conn:
        conn.execute(
            "UPDATE todos SET done=0, status='pending', completed_at='', updated_at=? WHERE id=?",
            (ts, tid)
        )
    print(f"Reopened #{tid}")


def cmd_edit(args):
    tid = require_id(args)
    text_parts, flags = parse_flags(args[1:], ["--priority", "--comment", "--deadline", "--category"])
    new_title = " ".join(text_parts).strip() or None
    priority  = flags["--priority"]
    comment   = flags["--comment"]
    deadline  = flags["--deadline"]
    category  = flags["--category"]

    if not any([new_title, priority, comment, deadline, category]):
        die("Provide new text, --priority, --comment, --deadline, or --category.")
    if priority and priority not in ("high", "medium", "low"):
        die("Priority must be: high, medium, or low.")

    task = find_or_die(tid)
    changed = []
    if new_title:
        task["title"] = new_title
        changed.append(f"title → {new_title!r}")
    if priority:
        task["priority"] = priority
        changed.append(f"priority → {priority}")
    if comment is not None:
        task["description"] = comment or None
        changed.append("description updated")
    if deadline is not None:
        task["due_date"] = deadline or None
        changed.append(f"due_date → {deadline}")
    if category is not None:
        task["category"] = category or None
        changed.append(f"category → {category!r}")

    ts = now_iso()
    with connect() as conn:
        conn.execute(
            "UPDATE todos SET title=?,priority=?,description=?,due_date=?,category=?,updated_at=? WHERE id=?",
            (task["title"], task["priority"], task["description"], task["due_date"], task["category"], ts, tid)
        )
    if deadline is not None or new_title or priority:
        cancel_deadline_alert(tid)
        if task.get("due_date"):
            schedule_deadline_alert(tid, task["title"], task["due_date"], task["priority"])
    print(f"Updated #{tid}: {', '.join(changed)}")


def cmd_delete(args):
    tid = require_id(args)
    task = find_or_die(tid)
    with connect() as conn:
        conn.execute("DELETE FROM todos WHERE id=?", (tid,))
    cancel_deadline_alert(tid)
    print(f"Deleted #{tid}: {task['title']}")


def cmd_help(_args=None):
    print(__doc__.strip())


# ── Router ─────────────────────────────────────────────────────────────────────
COMMANDS = {
    "add":     cmd_add,
    "list":    cmd_list,
    "done":    cmd_done,
    "undone":  cmd_undone,
    "edit":    cmd_edit,
    "delete":  cmd_delete,
    "help":    cmd_help,
}

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("--help", "-h", "help"):
        cmd_help()
        return
    cmd = args[0]
    if cmd not in COMMANDS:
        print(f"Error: unknown command '{cmd}'. Run 'todo help'.", file=sys.stderr)
        sys.exit(1)

    COMMANDS[cmd](args[1:])


if __name__ == "__main__":
    main()
