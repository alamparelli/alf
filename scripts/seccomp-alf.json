        "setregid", "setregid32", "setresgid", "setresgid32", "setresuid", "setresuid32",
        "setreuid", "setreuid32", "setrlimit", "set_robust_list", "setsid", "setsockopt",
        "set_thread_area", "set_tid_address", "setuid", "setuid32", "setxattr", "shmat",
        "shmctl", "shmdt", "shmget", "shutdown", "sigaltstack", "signalfd", "signalfd4",
        "sigprocmask", "sigreturn", "socket", "socketcall", "socketpair", "splice",
        "stat", "stat64", "statfs", "statfs64", "statx", "symlink", "symlinkat",
        "sync", "sync_file_range", "syncfs", "sysinfo", "tee", "tgkill", "time", "timer_create",
        "timer_delete", "timer_getoverrun", "timer_gettime", "timer_gettime64",
        "timer_settime", "timer_settime64", "timerfd_create", "timerfd_gettime",
        "timerfd_gettime64", "timerfd_settime", "timerfd_settime64", "times", "tkill",
        "truncate", "truncate64", "ugetrlimit", "umask", "uname", "unlink", "unlinkat",
        "utime", "utimensat", "utimensat_time64", "utimes", "vfork", "vmsplice", "wait4",
        "waitid", "waitpid", "write", "writev"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "x86/x86_64-specific syscalls required for thread-local storage and legacy local-descriptor-table operations. arch_prctl sets %fs base for TLS — without it, glibc/Go runtime cannot initialise threads (observed: container restart-loop with 'cannot set %fs base address for thread-local storage' on Ubuntu 6.8 amd64 kernel). Mirrors the architecture-conditional allow in moby/default.json.",
      "names": ["arch_prctl", "modify_ldt"],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "clone(): allow only when no new-namespace flags are set in arg0 (CLONE_NEW{NS,UTS,IPC,USER,PID,NET,CGROUP}). Mirrors Docker's moby/default.json non-CAP_SYS_ADMIN rule. CAP_SYS_ADMIN is dropped at the container boundary, so even bypassing this rule would fail at the kernel-cap check — this is belt-and-braces.",
      "names": ["clone"],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "value": 2114060288,
          "valueTwo": 0,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ]
    },
    {
      "_comment": "clone3(): allow unconditionally. The arg0 of clone3 is a pointer to struct clone_args, NOT a flags bitmap — applying the namespace-mask constraint to a pointer makes the rule fail randomly (observed: glibc 2.34+ pthread_create uses clone3 on x86_64, daemon crashed with `runtime/cgo: pthread_create failed: Operation not permitted`). Namespace creation via clone3 is still gated by CAP_SYS_ADMIN (dropped) at the kernel boundary.",
      "names": ["clone3"],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Explicit deny: syscalls the post-#406 daemon never uses. Listed here even though defaultAction=ERRNO would already block them — the explicit list is a forward-looking pin; if a future daemon path tries one of these, the build-time test (TODO) will flag it before merge.",
      "names": [
        "mount", "umount", "umount2",
        "pivot_root", "chroot",
        "init_module", "finit_module", "delete_module", "create_module",
        "kexec_load", "kexec_file_load",
        "perf_event_open",
        "open_by_handle_at",
        "syslog",
        "uselib",
        "vmsplice",
        "swapoff", "swapon",
        "iopl", "ioperm",
        "reboot",
        "_sysctl",
        "ptrace"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
