# AUTO-GENERATED by alf - do not edit manually.
# Custom overrides go in docker-compose.override.yml (merged automatically).
# Regenerate with: alf compose

name: alf-go

services:
{{- if .EnableHTTPS}}
  traefik:
    image: traefik:v3.6
    container_name: alf-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email={{.AcmeEmail}}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./letsencrypt:/letsencrypt
{{- end}}

  alf:
    image: {{.Image}}
    container_name: alf
    hostname: workspace
    restart: unless-stopped
    networks:
      default:
      whisper-internal:
      embed-internal:
    extra_hosts:
      # host.docker.internal → host gateway. Required on Linux (not provided by
      # default) and forces a stable /etc/hosts entry on Docker Desktop Mac/Win
      # where native resolution is occasionally flaky. Lets Ollama on the host
      # be reached at http://host.docker.internal:11434 cross-platform.
      - "host.docker.internal:host-gateway"
      - "whisper:10.99.0.10"
      - "embed:10.99.1.10"
{{- if .EnableHTTPS}}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.alf.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.alf.entrypoints=websecure"
      - "traefik.http.routers.alf.tls.certresolver=letsencrypt"
      - "traefik.http.services.alf.loadbalancer.server.port=8080"
      - "traefik.http.services.alf.loadbalancer.responseforwarding.flushinterval=-1"
{{- else}}
    ports:
      - "{{if .CCBind}}{{.CCBind}}{{else}}127.0.0.1{{end}}:{{.CCPort}}:8080"
{{- end}}
    environment:
      - ALF_CC_BIND=0.0.0.0
      - WHISPER_URL=http://whisper:8000
      - EMBED_URL=http://embed:8090
      - ALF_MARKETPLACE_URL=https://marketplace.alfos.ai
      - CC_EXTERNAL_URL={{.CCExternalURL}}
{{- if .Timezone}}
      - TZ={{.Timezone}}
{{- end}}
      # 0.8.0 dev-window gate: daemon refuses to start without this after
      # ticket #406 razed the legacy sandbox. Removed once ALF_OCAP_STRICT=1
      # ships post-#391 + #386. See docs/ARCHITECTURE-SECURITY.md §12.
      # Regenerated templates will drop this block when the dev window closes.
      - ALF_EXPERIMENTAL=1
    volumes:
      - ./secrets:/opt/alf/secrets-staging:ro
      - ./data:/home/alf/data
      # Daemon-private signing material (#395 §7.3 Tier 2 daemon
      # auto-bootstrap key + Tier 3 user-endorsed via `alf keygen`)
      # and the admin pending queue (chunk 3 DirStore). NAMED VOLUMES
      # on purpose: bind-mounts on Docker Desktop (macOS, Windows
      # WSL2) traverse a fakeowner FUSE/9p layer that ignores inode
      # uid/gid, letting the LLM subprocess (uid 1000) read alfd-owned
      # 0o600 files. Named volumes stay inside the Linux VM with real
      # ext4 DAC, so `cat /home/alf/data/keys/daemon.json` from the
      # LLM subprocess returns EACCES on every host (Linux native,
      # Docker Desktop macOS, Windows WSL2).
      #
      # Operators back up via `docker run --rm -v alf-go_alf-keys:/k
      # alpine tar czf - -C /k . > keys-backup.tar.gz` (replace volume
      # name with the project-prefixed actual name from `docker volume ls`).
      - alf-keys:/home/alf/data/keys
      - alf-admin:/home/alf/data/admin
      - ./config.d:/opt/alf/config.d
      - ./skills.d:/opt/alf/skills.d
      - ./cache/claude:/home/alf/.claude
      - ./cache/codex:/home/alf/.codex
      - ./cache/config:/home/alf/.config
      - ./cache/local:/home/alf/.local
      - ./cache/npm:/home/alf/.npm
      - ./cache/cache:/home/alf/.cache
      - ./local:/opt/alf/user-packages
      # Vault store + sidecar shared secrets (CC bearer, whisper,
      # embed, telegram). All daemon-private. Named volume — same
      # fakeowner reasoning. The vault.sock chmod-on-socket also works
      # inside ext4 (fails on Docker Desktop bind-mount with "invalid
      # argument" — the operator-visible boot warning post-fix won't
      # appear because the path is in a real Linux FS).
      - alf-vault:/opt/alf/vault-data
      - ./resolv.conf:/etc/resolv.conf:ro
{{- range .Workspaces}}
      - {{.}}:/workspaces/{{base .}}
{{- end}}
    runtime: ${ALF_RUNTIME:-runc}
    security_opt:
      # apparmor=unconfined is the legacy posture from the v0.7.x
      # sandbox (chroot+setpriv+bwrap needed mount(2) which AppArmor
      # blocked). #406 razed that layer; apparmor=unconfined is now
      # vestigial. The custom profile at scripts/apparmor-alf.profile
      # (#86 SEC-A01) is the planned replacement; activate via
      #
      #   sudo apparmor_parser -r -W /opt/alf/scripts/apparmor-alf.profile
      #   # then change this line to: - apparmor=alf
      #
      # Kept as `unconfined` until the profile has been soak-tested
      # against a full daemon boot — switching prematurely could
      # block legitimate startup syscalls.
      - apparmor=unconfined
      # Custom seccomp profile (#86 SEC-A11): activate via
      #   - seccomp=/opt/alf/scripts/seccomp-alf.json
      # See scripts/seccomp-alf.json. Same deferral rationale as
      # AppArmor: shipped, not yet activated by default.
    cap_drop:
      - ALL
    cap_add:
      # CHOWN/DAC_OVERRIDE/FOWNER: entrypoint Phase 1 (apt-get, chown, perms).
      # SETUID/SETGID: entrypoint + daemon (subprocess isolation via setpriv).
      # NET_ADMIN: nettrack-helper (conntrack events).
      #
      # Removed in v0.8.0 (#86 SEC-A02 + #406 deferred follow-up):
      #   - SYS_ADMIN: was daemon's mount-namespace sandbox; razed in #406.
      #   - SYS_CHROOT: was daemon's chroot into sandbox root; razed in #406.
      # Code-search verified zero remaining callers of syscall.Mount /
      # Chroot / Unshare / PivotRoot in the daemon path.
      - CHOWN
      - SETUID
      - SETGID
      - DAC_OVERRIDE
      - FOWNER
      - NET_ADMIN

  whisper:
    image: {{.WhisperImage}}
    container_name: alf-whisper
    restart: unless-stopped
    networks:
      default:
      whisper-internal:
        ipv4_address: 10.99.0.10
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      - WHISPER_SHARED_SECRET_FILE=/run/secrets/whisper_shared_secret
      - WHISPER_MODEL={{.WhisperModel}}
    volumes:
      - ./secrets/whisper_shared_secret:/run/secrets/whisper_shared_secret:ro
    mem_limit: 2g
    cpus: "2.0"

  embed:
    image: {{.EmbedImage}}
    container_name: alf-embed
    restart: unless-stopped
    networks:
      embed-internal:
        ipv4_address: 10.99.1.10
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      - EMBED_SHARED_SECRET_FILE=/run/secrets/embed_shared_secret
    volumes:
      - ./secrets/embed_shared_secret:/run/secrets/embed_shared_secret:ro
    mem_limit: 1536m
    cpus: "1.0"

networks:
  whisper-internal:
    internal: true
    ipam:
      config:
        - subnet: 10.99.0.0/24
  embed-internal:
    internal: true
    ipam:
      config:
        - subnet: 10.99.1.0/24

volumes:
  # Named volumes for daemon-private storage. Stay inside the Docker
  # VM (Linux ext4) so DAC enforces alfd:alfd 0o600 properly even on
  # Docker Desktop hosts (macOS, Windows). The LLM subprocess running
  # as uid 1000 cannot read these files; the fakeowner bypass that
  # plagues bind-mounted host paths is bypassed by named volumes.
  # See docs/ARCHITECTURE-SECURITY.md §7.3 + the vendored README.
  alf-keys:
  alf-vault:
  alf-admin:

