name: alf-go

services:
  alf:
    image: ghcr.io/alamparelli/alf:latest
    container_name: alf
    restart: unless-stopped
    ports:
      - "0.0.0.0:{{.CCPort}}:8080"
    environment:
      - TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
      - TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
      - CC_AUTH_TOKEN_FILE=/run/secrets/cc_auth_token
      - CC_EXTERNAL_URL={{.CCExternalURL}}
    secrets:
      - telegram_bot_token
      - telegram_chat_id
      - cc_auth_token
    volumes:
      - ./data:/home/node/data
      - ./config.d:/home/node/data/config.d
      - ./tools.d:/home/node/data/tools.d:ro
      - ./skills.d:/home/node/data/skills.d:ro
    mem_limit: 512m
    cpus: "0.5"

secrets:
  telegram_bot_token:
    file: ./secrets/telegram_bot_token
  telegram_chat_id:
    file: ./secrets/telegram_chat_id
  cc_auth_token:
    file: ./secrets/cc_auth_token
