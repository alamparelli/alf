{
  "name": "Journal",
  "slug": "journal",
  "version": "0.2.0",
  "description": "Personal journaling with mood tracking and reflection",
  "author": "Alf",
  "category": "productivity",
  "icon": "book-open",
  "tools": [
    {
      "name": "journal",
      "description": "Personal journal: write, read, search, reflect on, or delete entries. Supports mood tracking and tagging.",
      "action": "journal",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["write", "read", "search", "reflect", "delete"],
            "description": "Action to perform"
          },
          "content": { "type": "string", "description": "Journal entry text (write)" },
          "mood": { "type": "string", "description": "Current mood, e.g. happy, calm, anxious (write)" },
          "tags": { "type": "string", "description": "Comma-separated tags (write)" },
          "id": { "type": "string", "description": "Entry ID (read one, delete)" },
          "limit": { "type": "integer", "description": "Number of recent entries (read, default 10)" },
          "query": { "type": "string", "description": "Search query (search)" },
          "days": { "type": "integer", "description": "Days to reflect on (reflect, default 7)" }
        },
        "required": ["action"]
      }
    }
  ]
}
