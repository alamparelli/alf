# AUTO-GENERATED by alf - do not edit manually.
# Custom overrides go in docker-compose.override.yml (merged automatically).
# Regenerate with: alf compose

name: alf-go

services:
{{- if .EnableHTTPS}}
  traefik:
    image: traefik:v3.6
    container_name: alf-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email={{.AcmeEmail}}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./letsencrypt:/letsencrypt
{{- end}}

  alf:
    image: {{.Image}}
    container_name: alf
    hostname: workspace
    restart: unless-stopped
    networks:
      default:
      whisper-internal:
      embed-internal:
    extra_hosts:
      - "whisper:10.99.0.10"
      - "embed:10.99.1.10"
{{- if .EnableHTTPS}}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.alf.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.alf.entrypoints=websecure"
      - "traefik.http.routers.alf.tls.certresolver=letsencrypt"
      - "traefik.http.services.alf.loadbalancer.server.port=8080"
      - "traefik.http.services.alf.loadbalancer.responseforwarding.flushinterval=-1"
{{- else}}
    ports:
      - "0.0.0.0:{{.CCPort}}:8080"
{{- end}}
    environment:
      - CLAUDE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token
      - WHISPER_URL=http://whisper:8000
      - WHISPER_SHARED_SECRET_FILE=/run/secrets/whisper_shared_secret
      - EMBED_URL=http://embed:8090
      - EMBED_SHARED_SECRET_FILE=/run/secrets/embed_shared_secret
      - ALF_MARKETPLACE_URL=https://marketplace.lamparelli.eu
      - CC_EXTERNAL_URL={{.CCExternalURL}}
{{- if .Timezone}}
      - TZ={{.Timezone}}
{{- end}}
    secrets:
      - source: claude_oauth_token
        uid: "1000"
        gid: "1000"
        mode: 0400
      - source: whisper_shared_secret
        target: /run/secrets/whisper_shared_secret
        uid: "1001"
        gid: "1001"
        mode: 0400
      - source: embed_shared_secret
        target: /run/secrets/embed_shared_secret
        uid: "1001"
        gid: "1001"
        mode: 0400
    volumes:
      - ./data:/home/alf/data
      - ./config.d:/opt/alf/config.d
      - ./skills.d:/opt/alf/skills.d
      - ./cache/claude:/home/alf/.claude
      - ./cache/codex:/home/alf/.codex
      - ./cache/config:/home/alf/.config
      - ./cache/local:/home/alf/.local
      - ./cache/npm:/home/alf/.npm
      - ./cache/cache:/home/alf/.cache
      - ./local:/opt/alf/user-packages
      - ./vault-data:/opt/alf/vault-data
      - ./resolv.conf:/etc/resolv.conf
{{- range .Workspaces}}
      - {{.}}:/workspaces/{{base .}}
{{- end}}
    mem_limit: 2g
    cpus: "2.0"
    runtime: ${ALF_RUNTIME:-runc}
    security_opt:
      # AppArmor blocks mount(2) even with CAP_SYS_ADMIN — unconfined required
      # for pivot_root sandbox. Caps are still explicitly limited below.
      - apparmor=unconfined
    cap_drop:
      - ALL
    cap_add:
      # CHOWN/DAC_OVERRIDE/FOWNER: entrypoint (apt-get, chown, file permissions)
      # SETUID/SETGID: entrypoint + daemon (credential switching for subprocess isolation)
      # SYS_ADMIN: daemon (mount namespace sandbox for app bash)
      # SYS_CHROOT: daemon (chroot into sandbox root)
      # NET_ADMIN: nettrack-helper (conntrack events)
      - CHOWN
      - SETUID
      - SETGID
      - SYS_ADMIN
      - SYS_CHROOT
      - DAC_OVERRIDE
      - FOWNER
      - NET_ADMIN

  whisper:
    image: {{.WhisperImage}}
    container_name: alf-whisper
    restart: unless-stopped
    networks:
      default:
      whisper-internal:
        ipv4_address: 10.99.0.10
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      - WHISPER_SHARED_SECRET_FILE=/run/secrets/whisper_shared_secret
      - WHISPER_MODEL={{.WhisperModel}}
    volumes:
      - ./secrets/whisper_shared_secret:/run/secrets/whisper_shared_secret:ro
    mem_limit: 2g
    cpus: "2.0"

  embed:
    image: {{.EmbedImage}}
    container_name: alf-embed
    restart: unless-stopped
    networks:
      embed-internal:
        ipv4_address: 10.99.1.10
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    environment:
      - EMBED_SHARED_SECRET_FILE=/run/secrets/embed_shared_secret
    volumes:
      - ./secrets/embed_shared_secret:/run/secrets/embed_shared_secret:ro
    mem_limit: 1536m
    cpus: "1.0"

networks:
  whisper-internal:
    internal: true
    ipam:
      config:
        - subnet: 10.99.0.0/24
  embed-internal:
    internal: true
    ipam:
      config:
        - subnet: 10.99.1.0/24

secrets:
  claude_oauth_token:
    file: ./secrets/claude_oauth_token
  whisper_shared_secret:
    file: ./secrets/whisper_shared_secret
  embed_shared_secret:
    file: ./secrets/embed_shared_secret
