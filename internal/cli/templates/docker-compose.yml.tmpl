# AUTO-GENERATED by alf — do not edit manually.
# Custom overrides go in docker-compose.override.yml (merged automatically).
# Regenerate with: alf compose

name: alf-go

services:
{{- if .EnableHTTPS}}
  traefik:
    image: traefik:v3.6
    container_name: alf-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.letsencrypt.acme.email={{.AcmeEmail}}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./letsencrypt:/letsencrypt
{{- end}}

  alf:
    image: {{.Image}}
    container_name: alf
    restart: unless-stopped
{{- if .EnableHTTPS}}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.alf.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.alf.entrypoints=websecure"
      - "traefik.http.routers.alf.tls.certresolver=letsencrypt"
      - "traefik.http.services.alf.loadbalancer.server.port=8080"
      - "traefik.http.services.alf.loadbalancer.responseforwarding.flushinterval=-1"
{{- else}}
    ports:
      - "0.0.0.0:{{.CCPort}}:8080"
{{- end}}
    environment:
      - TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
      - TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
      - CC_AUTH_TOKEN_FILE=/run/secrets/cc_auth_token
      - OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
      - CLAUDE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token
      - CC_EXTERNAL_URL={{.CCExternalURL}}
{{- if .Timezone}}
      - TZ={{.Timezone}}
{{- end}}
    secrets:
      - telegram_bot_token
      - telegram_chat_id
      - cc_auth_token
      - openrouter_api_key
      - claude_oauth_token
    volumes:
      - ./data:/home/alf/data
      - ./config.d:/opt/alf/config.d
      - ./skills.d:/opt/alf/skills.d
      - ./cache/claude:/home/alf/.claude
      - ./cache/local:/home/alf/.local
      - ./cache/npm:/home/alf/.npm
      - ./cache/cache:/home/alf/.cache
      - ./local:/opt/alf/user-packages
{{- range .Workspaces}}
      - {{.}}:/workspaces/{{base .}}
{{- end}}
    mem_limit: 2g
    cpus: "2.0"

secrets:
  telegram_bot_token:
    file: ./secrets/telegram_bot_token
  telegram_chat_id:
    file: ./secrets/telegram_chat_id
  cc_auth_token:
    file: ./secrets/cc_auth_token
  openrouter_api_key:
    file: ./secrets/openrouter_api_key
  claude_oauth_token:
    file: ./secrets/claude_oauth_token
