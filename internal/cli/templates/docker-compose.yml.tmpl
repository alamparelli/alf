name: alf-go

services:
  alf:
    image: ghcr.io/alamparelli/alf:latest
    container_name: alf
    restart: unless-stopped
    ports:
      - "2222:22"
      - "127.0.0.1:{{.CCPort}}:8080"
    environment:
      - TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
      - TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
      - CC_AUTH_TOKEN_FILE=/run/secrets/cc_auth_token
      - CC_EXTERNAL_URL=http://localhost:{{.CCPort}}
    secrets:
      - telegram_bot_token
      - telegram_chat_id
      - cc_auth_token
    volumes:
      - ./config.json:/home/node/data/config.json
      - ./data:/home/node/data
      - ./tools:/home/node/tools:ro
      - ./skills:/home/node/skills:ro
      - ./claude-session:/home/node/.claude
    mem_limit: 512m
    cpus: "0.5"

secrets:
  telegram_bot_token:
    file: ./secrets/telegram_bot_token
  telegram_chat_id:
    file: ./secrets/telegram_chat_id
  cc_auth_token:
    file: ./secrets/cc_auth_token
