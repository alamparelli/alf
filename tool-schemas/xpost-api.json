{
  "name": "xpost_api",
  "description": "Manage X/Twitter posts via XPost. Create drafts, schedule, publish, delete, retweet. All dates are ISO8601 (e.g. 2026-03-14T15:00:00).",
  "parameters": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "enum": [
          "list_posts",
          "get_post",
          "create_post",
          "schedule_post",
          "post_now",
          "unschedule_post",
          "delete_post",
          "next_slot",
          "retweet",
          "unretweet",
          "schedule_retweet"
        ],
        "description": "Action to perform"
      },
      "id": {
        "type": "string",
        "description": "Post ID (for get_post, schedule_post, post_now, unschedule_post, delete_post)"
      },
      "content": {
        "type": "string",
        "description": "Tweet text (for create_post)"
      },
      "scheduled_at": {
        "type": "string",
        "description": "ISO8601 datetime (for create_post, schedule_post, schedule_retweet)"
      },
      "filter": {
        "type": "string",
        "enum": ["all", "drafts", "scheduled", "history"],
        "description": "Filter type (for list_posts, default: all)"
      },
      "audience": {
        "type": "string",
        "enum": ["global", "community"],
        "description": "Audience type (for next_slot, default: global)"
      },
      "tweet_id": {
        "type": "string",
        "description": "Twitter tweet ID (for retweet, unretweet, schedule_retweet)"
      },
      "media": {
        "type": "string",
        "description": "Path to media file to attach (for create_post)"
      },
      "community": {
        "type": "string",
        "description": "Community ID (for create_post)"
      },
      "thread": {
        "type": "string",
        "description": "Thread parts as JSON array of strings (for create_post)"
      },
      "no-share": {
        "type": "boolean",
        "description": "If true, don't share with followers (for create_post in community)"
      }
    },
    "required": ["command"],
    "x-positional": ["command", "content", "id", "filter", "audience", "tweet_id", "scheduled_at"]
  }
}
